{
  "name": "@pi-desktop/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PI-Desktop Electron application",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "node ../../scripts/check-style-tokens.mjs",
    "clean": "rm -rf out dist",
    "bundle:runtime": "pnpm -C ../../packages/agent-runtime bundle",
    "pack": "pnpm run bundle:runtime && electron-vite build && electron-builder --mac --arm64 --dir",
    "dist": "pnpm run bundle:runtime && electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@pi-desktop/agent-runtime": "workspace:*",
    "@pi-desktop/i18n": "workspace:*",
    "@pi-desktop/plugin-sdk": "workspace:*",
    "@pi-desktop/shared": "workspace:*",
    "i18next": "^25.3.2",
    "katex": "^0.16.47",
    "lucide-react": "^1.26.0",
    "marked": "^18.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.pi-desktop.app",
    "productName": "PI-Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../target/release/pi-desktop-host-core",
        "to": "bin/pi-desktop-host-core"
      },
      {
        "from": "../../packages/agent-runtime/dist-bundle",
        "to": "agent-runtime"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "asar": true
  }
}
